---
// Pafta göstergesi (CLAUDE.md §3.1): sol altta her pafta için bir nokta, öndeki turuncu uzun çubuk.
// Süs: aynı bilgi sekmelerde (aria-current) var, bu yüzden ekran okuyucudan gizli (aria-hidden).
// Yalnızca JS varken görünür (Sahne'nin CSS'i); JS'siz düzende paftalar alt alta, "hangisi önde" anlamsız.
interface Props {
  idler: readonly string[];
}

const { idler } = Astro.props;
---

<div class="gosterge" aria-hidden="true">
  {idler.map((id) => <span class="nokta" data-isaret={id} />)}
</div>

<style>
  .gosterge {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nokta {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--gosterge);
    transition:
      width 0.35s ease,
      background-color 0.35s ease;
  }
  /* Öndeki pafta: durum çizgisi rengi, 3:1 (tests/renk.test.ts: "Aktif pafta göstergesi"). */
  .nokta[aria-current='true'] {
    width: 22px;
    background: var(--turuncu-cizgi);
  }

  @media (prefers-reduced-motion: reduce) {
    .nokta {
      transition: none;
    }
  }
</style>
