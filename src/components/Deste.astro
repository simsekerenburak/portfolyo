---
// Kart destesi (CLAUDE.md §3.2). Aşamalı geliştirme (§3.3):
//   JS yok  → kartlar alt alta düz bir liste (<ol>), her kartın kendi "i / n" sayacı var, hepsi okunur.
//   JS var  → Pafta.astro'daki betik kökteki data-deste="etkin" niteliğini koyar ve her karta
//             data-konum="on|orta|arka|gizli" yazar; aşağıdaki CSS kartları üst üste dizer.
// Mantık (hangi kart nerede) src/pafta/deste.ts'te; bu dosya yalnızca işaretleme ve görünüş.
import { METINLER, type Dil } from '../i18n';
import type { PaftaOgesi } from '../pafta/tipler';

interface Props {
  lang: Dil;
  ogeler: PaftaOgesi[];
  /** listenin ekran okuyucu adı: "Proje kartları" */
  etiket: string;
}

const { lang, ogeler, etiket } = Astro.props;
const m = METINLER[lang].pafta;
const n = ogeler.length;
---

<div class="kart-destesi" data-deste>
  <ol class="kartlar" aria-label={etiket}>
    {
      ogeler.map((o, i) => (
        <li class="kart" id={o.id} data-kart>
          {/* Arkadaki kartta görünen tek şey: üst şerit. İçerik zaten kartın kendisinde, okunmasın. */}
          <p class="serit" aria-hidden="true">
            {o.kisaAd} · {o.ustSatir}
          </p>
          <article class="icerik" aria-labelledby={`${o.id}-baslik`}>
            <div class="ust">
              <p class="ust-satir">{o.ustSatir}</p>
              {o.etiket && <span class="etiket">{o.etiket}</span>}
            </div>
            <h3 id={`${o.id}-baslik`}>{o.baslik}</h3>
            <p class="alt-satir">{o.altSatir}</p>
            {o.aciklama && <p class="aciklama">{o.aciklama}</p>}
            {o.haplar.length > 0 && (
              <ul class="haplar">
                {o.haplar.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
            {o.baglanti && (
              <a class="baglanti" href={o.baglanti.adres} rel="noopener">
                {o.baglanti.metin}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              </a>
            )}
            <p class="sayac">
              {i + 1} / {n}
            </p>
          </article>
        </li>
      ))
    }
  </ol>

  {/* Yalnızca JS varken görünür (CSS): öndeki kartın alt satırına oturan ortak sayaç ve oklar.
      Düğmeler kartın İÇİNDE değil: kart arkaya gidince odak kaybolmasın diye tek takım, destenin üstünde. */}
  <div class="denetim">
    <p class="sayac" data-sayac>1 / {n}</p>
    <div class="oklar">
      <button type="button" class="ok geri" data-onceki aria-label={m.onceki}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
      </button>
      <button type="button" class="ok ileri" data-sonraki aria-label={m.sonraki}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </button>
    </div>
    <p class="ekran-okuyucu" data-duyuru aria-live="polite"></p>
  </div>
</div>

<style>
  /* ── Ortak: kartın kendisi (iki modda aynı) ─────────────────────────────── */
  .kartlar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kart {
    position: relative;
    border: 1px solid var(--kart-cizgi);
    border-radius: 18px;
    background: var(--kart-on);
    box-shadow: 0 24px 50px var(--kart-golge);
  }

  .serit {
    display: none;
  }

  .icerik {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 22px 28px;
  }

  .ust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }

  /* Üst satır: mono, metin-2; önünde 6px turuncu nokta (turuncu YAZI değil, CLAUDE.md §4.2). */
  .ust-satir {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--metin-2);
    font: 13px/1.4 var(--font-mono);
  }
  .ust-satir::before,
  .etiket::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--turuncu);
  }

  .etiket {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--etiket-zemin);
    color: var(--vurgu-metin);
    font-size: 12px;
    line-height: 1.3;
  }

  h3 {
    margin: 4px 0 0;
    color: var(--metin);
    font-size: 27px;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .alt-satir {
    margin: 0;
    color: var(--metin-3);
    font-size: 14px;
  }

  .aciklama {
    max-width: 530px;
    margin: 6px 0 0;
    color: var(--metin-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .haplar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }
  .haplar li {
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--hap-zemin);
    color: var(--hap-metin);
    font-size: 12px;
    line-height: 1.3;
  }

  .baglanti {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 4px;
    min-height: 44px;
    color: var(--metin);
    font-size: 14px;
    font-weight: 500;
    text-underline-offset: 3px;
  }

  .icerik .sayac {
    display: flex;
    align-items: center;
    margin: auto 0 0;
    padding-top: 6px;
    color: var(--metin-3);
    font: 12px/1 var(--font-mono);
  }

  .denetim {
    display: none;
  }

  /* ── JS etkin: üst üste deste ───────────────────────────────────────────── */
  /* Bütün kartlar aynı ızgara hücresinde (grid-area: 1 / 1) üst üste durur; hücre en uzun kart kadar
     olur, böylece her kart aynı boyda. Arkadakiler --kaydir kadar sağa ve yukarı kayar; yukarıdaki
     boşluk (padding-top) onların üst şeritleri için. */
  .kart-destesi[data-deste='etkin'] {
    --kaydir: 20px;
    display: grid;
    padding-top: calc(2 * var(--kaydir));
  }
  [data-deste='etkin'] .kartlar {
    display: grid;
    grid-area: 1 / 1;
  }
  [data-deste='etkin'] .kart {
    grid-area: 1 / 1;
    width: calc(100% - 2 * var(--kaydir));
    transition:
      transform 0.35s ease,
      opacity 0.35s ease;
  }
  [data-deste='etkin'] .kart[data-konum='on'] {
    z-index: 3;
  }
  [data-deste='etkin'] .kart[data-konum='orta'] {
    z-index: 2;
    transform: translate(var(--kaydir), calc(-1 * var(--kaydir)));
    background: var(--kart-orta);
    box-shadow: none;
  }
  [data-deste='etkin'] .kart:is([data-konum='arka'], [data-konum='gizli']) {
    z-index: 1;
    transform: translate(calc(2 * var(--kaydir)), calc(-2 * var(--kaydir)));
    background: var(--kart-arka);
    box-shadow: none;
  }
  /* Dördüncü ve sonraki kartlar: en arkada, görünmez (en fazla 3 kart görünür). */
  [data-deste='etkin'] .kart[data-konum='gizli'] {
    z-index: 0;
    opacity: 0;
    visibility: hidden;
  }

  /* Arkadaki kartta içerik gizli (yer kaplamaya devam eder), yalnızca üst şerit görünür. */
  [data-deste='etkin'] .kart:not([data-konum='on']) .icerik {
    visibility: hidden;
  }
  [data-deste='etkin'] .kart:is([data-konum='orta'], [data-konum='arka']) .serit {
    display: block;
    position: absolute;
    inset: 0 0 auto;
    overflow: hidden;
    margin: 0;
    padding: 0 20px;
    font-size: 12px;
    line-height: var(--kaydir); /* şerit tam olarak öndeki kartın örtmediği bant kadar */
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  [data-deste='etkin'] .kart[data-konum='orta'] .serit {
    color: var(--metin-2);
  }
  [data-deste='etkin'] .kart[data-konum='arka'] .serit {
    color: var(--metin-3);
  }

  /* Kartın kendi sayacı görünmez ama 44px'lik satırı korur: ortak denetim (düğmeler 44px) tam onun
     üstüne oturur. */
  [data-deste='etkin'] .icerik .sayac {
    min-height: 44px;
    visibility: hidden;
  }
  [data-deste='etkin'] .denetim {
    display: flex;
    grid-area: 1 / 1;
    align-self: end;
    z-index: 4;
    align-items: center;
    justify-content: space-between;
    width: calc(100% - 2 * var(--kaydir));
    padding: 0 28px 22px;
    pointer-events: none; /* kartın altındaki boşluk tıklamayı yutmasın; yalnızca düğmeler tıklanır */
  }
  .denetim .sayac {
    margin: 0;
    color: var(--metin-3);
    font: 12px/1 var(--font-mono);
  }
  .oklar {
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }
  .ok {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .geri {
    border: 1px solid var(--dugme-cizgi);
    background: transparent;
    color: var(--metin);
  }
  .geri:hover {
    border-color: var(--turuncu-cizgi);
  }
  .ileri {
    border: 0;
    background: var(--turuncu);
    color: var(--turuncu-ustu);
  }

  /* Telefon: kaydırma payı küçülür (16px: 12px'lik şerit yazısı sığmıyordu), kart genişliği korunur.
     Ayrıntılı mobil tasarım M5'te. */
  @media (max-width: 599px) {
    .kart-destesi[data-deste='etkin'] {
      --kaydir: 16px;
    }
    .icerik,
    [data-deste='etkin'] .denetim {
      padding-inline: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-deste='etkin'] .kart,
    .ok {
      transition: none;
    }
  }
</style>
