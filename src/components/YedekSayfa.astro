---
// Yedek sayfa (CLAUDE.md §3.4): sitenin düz HTML hâli. Her zaman üretilir ve sayfada durur:
//   - JS kapalıyken, prefers-reduced-motion'da, WebGL yoksa ya da ziyaretçi "Düz görünüm"ü seçtiyse görünen sayfa budur,
//   - arama motorları tam içeriği buradan okur,
//   - 3D katman (M2'de gelecek) detay kartının içeriğini buradaki <article>'lardan alır (metin kopyalanmaz).
// Düzen: üstte bölüm linkleri + dil/tema düğmeleri, altında Hakkımda ve dört bölüm alt alta. JS varken bölümlerdeki
// kart destesi ve bant çalışır (Pafta.astro). Bölümlerin sırası CLAUDE.md §3.1'deki duraklarla aynı.
import { METINLER, type Dil } from '../i18n';
import type { SayfaVerisi } from '../icerik/koleksiyonlar';
import Belgeler from './Belgeler.astro';
import DilDugmesi from './DilDugmesi.astro';
import Hakkimda from './Hakkimda.astro';
import Projeler from './Projeler.astro';
import Sekmeler from './Sekmeler.astro';
import Stajlar from './Stajlar.astro';
import TemaDugmesi from './TemaDugmesi.astro';
import Yetkinlikler from './Yetkinlikler.astro';

interface Props {
  lang: Dil;
  veri: SayfaVerisi;
}

const { lang, veri: v } = Astro.props;
const m = METINLER[lang];
const bolumler = [
  { id: 'hakkimda', ad: m.sahne.hakkimda },
  { id: 'projeler', ad: m.projeler.baslik },
  { id: 'stajlar', ad: m.stajlar.baslik },
  { id: 'yetkinlikler', ad: m.yetkinlikler.baslik },
  { id: 'belgeler', ad: m.belgeler.baslik },
];
---

<main data-yedek>
  <div class="sayfa">
    <header class="ust">
      <Sekmeler sekmeler={bolumler} etiket={m.sahne.sekmeEtiketi} />
      <div class="dugmeler">
        {/* 3D açılmadıysa ve ziyaretçi açabilecekse (Düz görünüm seçti / hareket azaltma) giris.ts gösterir */}
        <button
          type="button"
          class="dugme-3d"
          data-3d-ac
          data-metin-duz={m.pcb.ucGorunum}
          data-metin-hareket={m.pcb.ucYineDe}
          hidden>{m.pcb.ucGorunum}</button>
        <DilDugmesi lang={lang} />
        <TemaDugmesi lang={lang} />
      </div>
    </header>

    <Hakkimda lang={lang} />
    <Projeler lang={lang} kayitlar={v.projeler} />
    <Stajlar lang={lang} stajlar={v.stajlar} />
    <Yetkinlikler lang={lang} alanlar={v.alanlar} kaynak={{ projeler: v.projeler, stajlar: v.stajlar }} />
    <Belgeler lang={lang} belgeler={v.belgeler} />
  </div>
</main>

<style>
  .sayfa {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* sütun kabı aşmasın (bkz. temel.css main) */
    gap: clamp(32px, 6vw, 72px);
    width: min(100%, 1184px);
  }
  .ust {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .dugmeler {
    display: flex;
    flex: none;
    gap: 8px;
  }
  /* DilDugmesi ile aynı hap biçimi */
  .dugme-3d {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--dugme-cizgi);
    border-radius: 999px;
    background: transparent;
    color: var(--hap-metin);
    font: 500 13px/1 var(--font-govde);
    cursor: pointer;
  }
  .dugme-3d[hidden] {
    display: none;
  }
  .dugme-3d:hover {
    background: var(--hap-zemin);
  }

  /* Telefon: dil/tema düğmeleri üstte sağda, bölüm linkleri altında tam genişlikte kayan şerit (§8). */
  @media (max-width: 599px) {
    .ust {
      flex-wrap: wrap;
      gap: 8px;
    }
    .dugmeler {
      order: -1;
      margin-inline-start: auto;
    }
    .ust > :global(.sekmeler) {
      flex-basis: 100%;
    }
  }
</style>
