---
// Ana sayfa (EN). İçerik M6'ya kadar kaba çeviri: en.json'daki ve EN içerik dosyalarındaki
// `taslak: true` → <html data-taslak>, kontrol.mjs bunu uyarı olarak gösterir.
import Hakkimda from '../../components/Hakkimda.astro';
import Projeler from '../../components/Projeler.astro';
import Stajlar from '../../components/Stajlar.astro';
import { METINLER } from '../../i18n';
import { sayfaVerisi } from '../../icerik/koleksiyonlar';
import Duzen from '../../layouts/Duzen.astro';

const m = METINLER.en;
const v = await sayfaVerisi('en');
---

<Duzen lang="en" baslik={m.site.baslik} aciklama={m.site.aciklama} taslak={v.taslak}>
  <main>
    <Hakkimda lang="en" />
    <Projeler lang="en" kayitlar={v.projeler} />
    <Stajlar lang="en" stajlar={v.stajlar} />
  </main>
</Duzen>
