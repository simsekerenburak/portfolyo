---
// Ana sayfa (TR). M1: paftalar alt alta (JS'siz düz hâl); M2'de Sahne onları üst üste deste yapacak.
import Belgeler from '../components/Belgeler.astro';
import Hakkimda from '../components/Hakkimda.astro';
import Projeler from '../components/Projeler.astro';
import Stajlar from '../components/Stajlar.astro';
import Yetkinlikler from '../components/Yetkinlikler.astro';
import { METINLER } from '../i18n';
import { sayfaVerisi } from '../icerik/koleksiyonlar';
import Duzen from '../layouts/Duzen.astro';

const m = METINLER.tr;
const v = await sayfaVerisi('tr');
---

<Duzen lang="tr" baslik={m.site.baslik} aciklama={m.site.aciklama} taslak={v.taslak}>
  <main>
    <Hakkimda lang="tr" />
    <Projeler lang="tr" kayitlar={v.projeler} />
    <Stajlar lang="tr" stajlar={v.stajlar} />
    <Yetkinlikler lang="tr" alanlar={v.alanlar} kaynak={{ projeler: v.projeler, stajlar: v.stajlar }} />
    <Belgeler lang="tr" belgeler={v.belgeler} />
  </main>
</Duzen>
