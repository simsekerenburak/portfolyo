---
// Ana sayfa (TR): beş paftalık sahne. Paftaların sırası ve gezinme Sahne.astro'da.
import Sahne from '../components/Sahne.astro';
import { METINLER } from '../i18n';
import { sayfaVerisi } from '../icerik/koleksiyonlar';
import Duzen from '../layouts/Duzen.astro';

const m = METINLER.tr;
const v = await sayfaVerisi('tr');
---

<Duzen lang="tr" baslik={m.site.baslik} aciklama={m.site.aciklama} taslak={v.taslak}>
  <Sahne lang="tr" veri={v} />
</Duzen>
